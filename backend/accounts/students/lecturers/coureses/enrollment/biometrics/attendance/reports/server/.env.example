# Port for the Express server. Hosting platforms may provide this automatically.
PORT=5000

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# Exact browser origin used for WebAuthn verification, including scheme and port if needed.
WEBAUTHN_ORIGIN=http://localhost:5173

# WebAuthn relying-party ID: hostname only, with no scheme, port, or path.
WEBAUTHN_RP_ID=localhost